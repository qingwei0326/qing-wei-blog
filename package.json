{
  "name": "money-saving-blog",
  "version": "1.0.0",
  "description": "青微的博客",
  "type": "module",
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:links": "node scripts/validate-built-links.mjs",
    "docs:check": "node scripts/validate-blog.mjs",
    "docs:render-check": "node scripts/check-rendered-site.mjs",
    "optimize:images": "node scripts/optimize-images.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "verify": "pnpm run docs:check && pnpm run lint && pnpm run docs:build && pnpm run docs:links"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "feed": "^5.2.1",
    "gray-matter": "^4.0.3",
    "prettier": "^3.8.4",
    "sharp": "^0.35.0",
    "typescript": "^5.6.0",
    "vitepress": "^1.0.0",
    "vitepress-theme-teek": "^1.5.7",
    "vue": "^3.4.0"
  }
}
